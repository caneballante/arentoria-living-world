# Copy to .env.local (kept out of git) and fill in. Restart the app after changes.

# Sending reports to DungeonShare's Pie Shop pages (the party's campaign only).
# The key must match DUNGEONSHARE_PIESHOP_TOKEN on DungeonShare (32+ characters).
DUNGEONSHARE_PIESHOP_TOKEN=
# The campaign's slug in its DungeonShare address: dungeonshare.vercel.app/campaign/<slug>
DUNGEONSHARE_CAMPAIGN_SLUG=
# Optional: defaults to https://dungeonshare.vercel.app
# DUNGEONSHARE_URL=

# Optional: where campaign files are kept (defaults to ./campaigns)
# ARENTORIA_CAMPAIGN_DIR=
