{
  "name": "arentoria-living-world",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent, simulation-driven companion to a D&D campaign set in Arentoria.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "launch": "node scripts/launch.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/run-scenario.ts",
    "compare": "tsx scripts/compare-scenarios.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
